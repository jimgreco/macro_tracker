PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/macro_tracker
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
# Optional: inline PEM cert or cert file path for DB TLS validation
PGSSL_CA_CERT=
PGSSL_CA_FILE=
SESSION_SECRET=change_this_session_secret
SESSION_TTL_DAYS=30
APP_BASE_URL=http://localhost:3000
APP_BUILD=local
TRUST_PROXY_HOPS=1
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPEN_FOOD_FACTS_USER_AGENT="Macrovana/1.0 (https://macrovana.com)"
AI_DAILY_MEAL_PARSE_LIMIT=20
AI_DAILY_WORKOUT_PARSE_LIMIT=30
AI_DAILY_PHOTO_PARSE_LIMIT=8
AI_DAILY_ANALYSIS_LIMIT=2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_IOS_CLIENT_ID=your_ios_google_client_id
# Optional comma-separated admin allowlists for /admin and admin-only UI details.
ADMIN_EMAILS=
ADMIN_USER_IDS=
# Local-only web auth bypass for preview/dev testing (ignored in production).
# iOS Debug builds can still request a dev token from /auth/dev/mobile without enabling this.
LOCAL_AUTH_BYPASS=false
LOCAL_DEV_USER_ID=local-dev-user
LOCAL_DEV_USER_NAME=Local Preview User
LOCAL_DEV_USER_EMAIL=local-preview@example.com
# Apple Sign-In (required for Sign in with Apple)
APPLE_CLIENT_ID=com.dailymacros.web
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=http://localhost:3000/auth/apple/callback
APPLE_BUNDLE_ID=com.dailymacros.app
# Oura Cloud API (server-side OAuth + signed near-real-time webhooks)
OURA_CLIENT_ID=your_oura_client_id
OURA_CLIENT_SECRET=your_oura_client_secret
OURA_REDIRECT_URI=http://localhost:3000/auth/oura/callback
# Generate with: openssl rand -base64 32
OURA_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key
# Production must be a public HTTPS URL registered with Oura.
OURA_WEBHOOK_URL=https://macrovana.com/webhooks/oura
OURA_WEBHOOK_VERIFICATION_TOKEN=long_random_webhook_verification_token
# Daily aggregates are enabled by default. Direct workout import is opt-in until source reconciliation ships.
OURA_INCLUDE_WORKOUTS=false
# Webhooks deliver normal updates; this interval repairs missed events.
OURA_RECONCILIATION_MINUTES=60
# Stripe billing (required for paid subscriptions)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
