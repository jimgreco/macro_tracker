{
  "name": "macro-tracker-app",
  "version": "1.0.0",
  "description": "Web macro tracker with natural language meal parsing",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node -e \"require('./src/db').initDb().then(() => console.log('DB initialized')).catch((err) => { console.error(err.message); process.exit(1); })\"",
    "ops:rotate-prod-db-password": "bash scripts/rotate-prod-db-password.sh",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:seed:local": "node scripts/load-local-test-data.js",
    "test": "node --test test/*.test.js",
    "test:db:integration": "node --test --test-concurrency=1 test/db-integration.test.js test/webhook-inbox-db.test.js",
    "test:db:upgrade": "node --test test/db-upgrade-path.test.js",
    "test:e2e": "playwright test --config playwright.config.js",
    "test:e2e:accessibility": "playwright test --config playwright.config.js test/e2e/accessibility.spec.js",
    "test:check": "node --check public/login.js && node --check public/today-state.js && node --check public/coach-rules.js && node --check public/script.js && node --check src/today-summary.js && node --check src/server.js && npm test"
  },
  "dependencies": {
    "apple-signin-auth": "^2.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-session": "^1.18.1",
    "heic-convert": "^2.1.0",
    "openai": "^4.86.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.18.0",
    "stripe": "^20.4.1"
  },
  "overrides": {
    "path-to-regexp": "0.1.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "playwright-core": "1.61.1"
  }
}
